# ========================================================
# HavItAll Store - Environment Configuration Template
# ========================================================
# HOW TO USE:
# 1. Local Development: Copy this file to '.env.local' and set your real values.
# 2. Production (Vercel / VPS): Add these variables in your hosting environment settings.
# ========================================================

# 1. MongoDB Atlas Database Connection (Required)
# Format: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/havitall?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.qnhfjkl.mongodb.net/havitall?retryWrites=true&w=majority

# 2. Business Koro Live Dropshipping & Fulfillment API (Required for supplier sync)
BUSINESS_KORO_API_KEY=your_business_koro_api_key_here
BUSINESS_KORO_BASE_URL=https://api.businesskoro.com/api/v1/storefront
BUSINESS_KORO_ORIGIN=https://havitall.shop

# 3. Secure Admin Authentication Credentials (Required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_PIN=1234
SESSION_SECRET=havitall_super_secret_session_encryption_key_2026_change_in_prod

# 4. Storefront Configuration (Public)
NEXT_PUBLIC_STORE_NAME=HavItAll
NEXT_PUBLIC_STORE_TAGLINE="Luxury & Lifestyle E-Commerce"
NEXT_PUBLIC_CURRENCY=৳
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=1500
NEXT_PUBLIC_SITE_URL=https://havitall.shop

# 5. Meta (Facebook) Pixel ID (Optional)
NEXT_PUBLIC_FB_PIXEL_ID=1089367523503019
